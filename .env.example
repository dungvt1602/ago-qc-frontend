# ===== AGO QC App — biến môi trường =====

# URL backend QC mà Next.js proxy /api tới (server-side, không lộ ra trình duyệt).
# Dùng khi NEXT_PUBLIC_API_URL để trống.
BACKEND_URL=https://ago-qc-backend.onrender.com

# Để trống → trình duyệt gọi same-origin /api, Next.js chuyển tiếp sang BACKEND_URL
#            (không cần CORS; phù hợp dev + self-host).
# Đặt URL đầy đủ tới endpoint /api của backend → trình duyệt gọi THẲNG backend
#            (giống bản vanilla; backend đã bật CORS). Khuyến nghị khi deploy static/Vercel
#            để ảnh upload không phải đi vòng qua server Next.
NEXT_PUBLIC_API_URL=https://ago-qc-backend.onrender.com/api
